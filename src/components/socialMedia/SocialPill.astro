---
import type { HTMLAttributes } from "astro/types";

type Props = {
  href: string;
  size: string;
  svgRef: string;
  aria_label: string;
  srIndex?: number;
  class?: string;
} & HTMLAttributes<"a">;

const {
  href,
  size,
  svgRef,
  aria_label,
  srIndex,
  class: className,
  ...rest
} = Astro.props;

const isExternal = href.startsWith("http");
---

<a
  href={href}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  aria-label={aria_label}
  class:list={[
    "border-border text-text bg-surface-raised hover:border-brand hover:text-brand flex items-center justify-center gap-x-2 rounded-full border px-3 py-3 no-underline transition-transform hover:scale-105",
    className,
  ]}
  style={srIndex !== undefined ? `--sr-index: ${srIndex}` : undefined}
  {...rest}
>
  <svg class=`icon ${size}`>
    <use href={`/sprite.svg${svgRef}`}></use>
  </svg>
  <slot />
</a>

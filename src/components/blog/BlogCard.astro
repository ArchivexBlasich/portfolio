---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import PostMeta from "./PostMeta.astro";

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  heroImage?: ImageMetadata;
  locale: "en" | "es";
  priority?: boolean;
  srIndex?: number;
}

const {
  href,
  title,
  description,
  pubDate,
  heroImage,
  locale,
  priority = false,
  srIndex = 0,
} = Astro.props;
---

<article
  data-scroll-reveal
  style={`--sr-index: ${srIndex}`}
  class="border-border bg-surface-raised group hover:border-brand/40 card-lift relative rounded-lg border p-4 transition-all duration-200"
>
  {
    heroImage && (
      <Image
        src={heroImage}
        alt=""
        priority={priority}
        loading={priority ? "eager" : "lazy"}
        format="png"
        widths={[320, 640, 1024, 1600]}
        sizes="(min-width: 1600px) 1600px, 100vw"
        class="mb-4 aspect-video w-full rounded-md object-contain"
      />
    )
  }

  <h2 class="text-xl">
    <a
      href={href}
      class="text-text group-hover:text-brand underline-offset-2 transition-colors after:absolute after:inset-0"
    >
      {title}
    </a>
  </h2>

  <p class="text-text-subtle mt-2 text-sm">{description}</p>

  <div class="mt-3">
    <PostMeta pubDate={pubDate} locale={locale} />
  </div>
</article>

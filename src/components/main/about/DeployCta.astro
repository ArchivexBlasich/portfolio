---
import { t } from "../../../i18n/ui";
import deployImage from "../../../assets/blog/deploy-vps.png";

interface Props {
  deployHref?: string;
  locale: "en" | "es";
  class?: string;
  srIndex?: number;
}

const { deployHref, locale, class: className, srIndex = 0 } = Astro.props;
---

<article
  data-scroll-reveal
  style={`--sr-index: ${srIndex}`}
  class:list={[
    "relative flex flex-col rounded-lg border p-4 transition-all duration-500 ease-out",
    "border-border bg-surface-raised card-lift",
    deployHref && "group hover:border-brand/40 hover:bg-brand/[0.04]",
    className,
  ]}
>
  <h3
    class:list={[
      "text-xl font-bold transition-colors duration-300",
      deployHref ? "text-brand group-hover:text-brand-hover" : "text-text",
    ]}
  >
    {t("deployCta.heading", locale)}
  </h3>

  <p class="text-text-subtle mt-2 text-sm">
    {t("deployCta.description", locale)}
  </p>

  {
    deployHref ? (
      <>
        <span
          aria-hidden="true"
          class="text-brand/70 mt-3 inline-flex -translate-x-1 items-center gap-1 text-sm font-medium opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100"
        >
          {t("deployCta.cta", locale)}→
        </span>
        <a
          href={deployHref}
          class="after:absolute after:inset-0"
          aria-label={`${t("deployCta.cta", locale)}: ${t("deployCta.heading", locale)}`}
        />
      </>
    ) : (
      <span class="text-text-muted mt-3 inline-block text-sm">
        {t("deployCta.comingSoon", locale)}
      </span>
    )
  }

  <div
    class="mt-4 flex flex-1 items-center justify-center overflow-hidden rounded-md"
  >
    <img
      src={deployImage.src}
      alt=""
      width={deployImage.width}
      height={deployImage.height}
      class:list={[
        "max-h-48 w-full object-contain opacity-80 transition-all duration-500 ease-out",
        deployHref && "group-hover:scale-105 group-hover:opacity-100",
      ]}
      loading="lazy"
    />
  </div>
</article>

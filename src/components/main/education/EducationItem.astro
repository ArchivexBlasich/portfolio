---
import type { CollectionEntry } from "astro:content";
import type { ImageMetadata } from "astro";
import { t, type Locale } from "../../../i18n/ui";

type Props = {
  education: CollectionEntry<"education">["data"];
  locale: Locale;
  index?: number;
};

const { institution, degree, image, startDate, endDate, yearOnly, highlights } =
  Astro.props.education;
const locale = Astro.props.locale;
const { index = 0 } = Astro.props;

const img: ImageMetadata = image;

function formatDate(date: Date, dateLocale: Locale): string {
  const formatted = date.toLocaleDateString(
    dateLocale === "en" ? "en-US" : "es-AR",
    { month: "long", year: "numeric" },
  );
  return formatted.charAt(0).toUpperCase() + formatted.slice(1);
}

function formatDateRange(
  start: Date,
  dateLocale: Locale,
  end: Date | undefined,
  yearOnly: boolean,
): string {
  if (yearOnly) {
    const startStr = String(start.getFullYear());
    if (!end) return `${startStr} – ${t("education.present", dateLocale)}`;
    return `${startStr} – ${end.getFullYear()}`;
  }
  const startStr = formatDate(start, dateLocale);
  if (!end) return `${startStr} – ${t("education.present", dateLocale)}`;
  return `${startStr} ${t("experience.dateTo", dateLocale)} ${formatDate(end, dateLocale)}`;
}

const dateRange = formatDateRange(startDate, locale, endDate, yearOnly);
---

<li class="ms-6 mb-6 sm:mb-10">
  <div
    class="bg-brand border-brand absolute -start-1.5 mt-1.5 h-3 w-3 rounded-full border"
  >
  </div>

  <div
    data-scroll-reveal
    style={`--sr-index: ${index}`}
    class="flex items-start gap-4"
  >
    <img
      src={img.src}
      alt={institution}
      width="48"
      height="48"
      class="mt-1 h-12 w-12 shrink-0 rounded-full object-contain"
      loading="lazy"
    />

    <div>
      <time
        class="text-text-muted mb-1 text-sm leading-none font-normal sm:text-base"
      >
        {dateRange}
      </time>

      <h3 class="text-brand mt-2 text-lg font-semibold sm:text-xl lg:text-2xl">
        {degree}
      </h3>

      <p class="text-text-muted mt-1 text-sm leading-none sm:text-base">
        {institution}
      </p>

      {
        highlights && highlights.length > 0 && (
          <ol class="mt-4 ml-5 list-decimal">
            {highlights.map((highlight) => (
              <li class="text-text-subtle mb-4 text-base font-normal text-pretty sm:text-lg">
                {highlight}
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </div>
</li>
